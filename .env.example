# Copy this file to the repository root as .env, then set every required value.
# These are OpenBot's native environment names. No credentials are generated.
# Keep .env local and out of Git. Do not use docker compose config without --quiet
# on a populated environment: rendered configuration can contain credentials.

# Blueprint selection (Compose controls, not model credentials).
COMPOSE_PROJECT_NAME=openbot-blueprint
BLUEPRINT_DIR=./blueprints/software-development-custom-bot
BLUEPRINT_INCLUDE_OPTIONAL=true

# Native model configuration. This pinned tenant loader supports openai/anthropic.
BOT_PROVIDER=openai
BOT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# LM Studio: set OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# Keep BOT_PROVIDER=openai and set BOT_MODEL to the ID from the local /v1/models endpoint.
# Set OPENAI_API_KEY=lm-studio for an unauthenticated local endpoint. The built-in client requires a value.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Native CopilotKit Intelligence configuration. Supply one project key.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
CPK_INTELLIGENCE_API_KEY=
INTELLIGENCE_API_KEY=
# Optional for a licensed self-hosted Intelligence deployment.
COPILOTKIT_LICENSE_TOKEN=

# Local development defaults for the bundled PostgreSQL service.
# To customize them, update DATABASE_URL to match and percent-encode reserved URL characters.
POSTGRES_USER=openbot
POSTGRES_DB=openbot
POSTGRES_PASSWORD=openbot
DATABASE_URL=postgres://openbot:openbot@postgres:5432/openbot

# Native vault and internal service credentials; all are required by this stack.
# KEY_ENCRYPTION_KEY must be a base64-encoded 32-byte random value.
# Generate locally, for example with: openssl rand -base64 32
# Set separate random values of at least 32 characters for the other tokens.
KEY_ENCRYPTION_KEY=
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=
AGENT_TOOL_TOKEN=
WORKER_SHARED_SECRET=

# Private durable workflow service; use three random values of at least 32 characters, distinct from each other and all native service tokens.
WORKFLOW_POSTGRES_PASSWORD=
WORKFLOW_ACTIVITY_TOKEN=
WORKFLOW_ENGINE_TOKEN=

# Local single-user deployment: all visitors are one administrator.
# Compose publishes the application on loopback only.
OPENBOT_SINGLE_USER=true
APP_PORT=3010
PORT=3001
SERVER_PORT=3001
TRUSTED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
TENANT_PACKAGE_DIR=/tenant/current
COMPUTER_BROWSER_MODE=headed
# Override only if the Docker socket is elsewhere on the Docker engine host.
ENGINE_SOCKET=/var/run/docker.sock
# Native settings for supervisor-managed computers.
COMPUTER_MEMORY_BYTES=4294967296
COMPUTER_RUNTIME=

# For shared deployments, set OPENBOT_SINGLE_USER=false and configure native auth.
# Optional host directory to browse in the project folder picker. Mounted read-only.
# PROJECTS_HOST_DIR=./projects
# Project VM provider: use the same long random token for the app and host process.
# WORKSPACE_PROVIDER_TOKEN=
# WORKSPACE_PROVIDER_URL=http://host.docker.internal:4511
# WORKSPACE_PROVIDER_INSTALLATION_ID=openbot-blueprint

# Optional disposable staging adapter. All three must be configured to enable
# approved deployment; STAGING_TARGET_ID must match the project release target.
# STAGING_TARGET_URL=http://host.docker.internal:4520
# STAGING_TARGET_TOKEN=
# STAGING_TARGET_ID=staging

# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# INITIAL_ADMIN_EMAILS=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=
# OKTA_OAUTH_CLIENT_ID=
# OKTA_OAUTH_CLIENT_SECRET=
# OKTA_OAUTH_ISSUER=

# Add project-specific native connector settings and any remote bot endpoint
# variables here. Connect and grant tools in OpenBot after startup.

# Provisioned by the default root Compose stack: native endpoint/token settings.
MANAGED_AGENT_AG_UI_URL=http://implementer-bot:4201/ag-ui
MANAGED_AGENT_TOKEN=
AGENT_ENDPOINT_ALLOWED_HOSTS=implementer-bot:4201
# The bot's separate environment file uses native BOT_PROVIDER/BOT_MODEL/key names.
IMPLEMENTER_ENV_FILE=.env.implementer

[
  {
    "id": "product-discovery",
    "description": "Investigate a product question and return a recommendation or change brief.",
    "outcomes": [
      "adoption recommendation",
      "product discovery",
      "prioritize product"
    ],
    "startPhase": "clarify",
    "terminalPhases": [
      "done"
    ],
    "phases": [
      {
        "id": "clarify",
        "action": "clarify"
      },
      {
        "id": "discover",
        "action": "discover"
      },
      {
        "id": "done",
        "terminal": true
      }
    ],
    "transitions": [
      {
        "from": "clarify",
        "to": "discover",
        "when": {
          "status": "succeeded"
        }
      },
      {

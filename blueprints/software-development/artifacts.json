  {
    "id": "qa-evidence",
    "description": "qa evidence",
    "owner": "qa",
    "producers": [
      "qa"
    ],
    "consumers": [
      "qa",
      "release"
    ],
    "schema": {
      "type": "object",
      "properties": {
        "candidateRevision": {
          "type": "string",
          "minLength": 1
        },
        "briefRevision": {
          "type": "string",
          "minLength": 1
        },
        "planRevision": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "pending"
          ]
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "blocked",
                  "not-run"
                ]
              },
              "observed": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                },
                "required": [
                  "status",
                  "observed"
                ]
              },
              {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                },
                "required": [
                  "status",
                  "observed"
                ]
              },
              {
                "properties": {
                  "status": {
                    "const": "blocked"
                  }
                },
                "required": [
                  "status",
                  "reason"
                ]
              },
              {
                "properties": {
                  "status": {
                    "const": "not-run"
                  }
                },
                "required": [
                  "status",
                  "reason"
                ]
              }
            ]
          }
        },
        "passPercentage": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "candidateRevision",
        "briefRevision",
        "planRevision",
        "environment",
        "verdict",
        "results",
        "passPercentage"
      ],
      "additionalProperties": false
    },
    "states": [
      "draft",
      "verified"
    ],
    "relationships": []
  },

# Copy to .env.implementer at the repository root. Supply credentials locally.
# Only this file is loaded by implementer-bot; it does not receive the platform's
# database, vault or Intelligence credentials.
BOT_PROVIDER=openai
BOT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# LM Studio: set OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# Keep BOT_PROVIDER=openai and set BOT_MODEL to the ID from the local /v1/models endpoint.
# Leave OPENAI_API_KEY blank for an unauthenticated local implementer endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Optional native LangGraph model parameters. Only set supported combinations.
# OpenAI Responses API only; use a compatible model if enabling reasoning effort.
BOT_RESPONSES_API=false
BOT_REASONING_EFFORT=

# MANAGED_AGENT_TOKEN and AGENT_TOOL_TOKEN are injected by the root Compose stack
# from the platform's .env. Keep them out of this second file to avoid drift.
